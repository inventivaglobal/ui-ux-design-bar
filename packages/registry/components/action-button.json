{
  "id": "action-button",
  "status": "draft",
  "foundation": "@mui/material/Button",
  "purpose": "Primary and secondary user actions",
  "variants": [
    "primary",
    "secondary",
    "destructive"
  ],
  "requiredChecks": [
    "accessible-name",
    "keyboard-activation",
    "focus-visible",
    "contrast",
    "disabled-state"
  ],
  "replacement": {
    "requiresApproval": true,
    "preserve": [
      "onClick",
      "type",
      "form",
      "aria-*",
      "data-*"
    ]
  },
  "source": "mui/material-ui"
}
